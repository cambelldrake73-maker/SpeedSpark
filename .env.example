# Copy this file to .env in the same folder (project root), then fill in your values.
# Get these from: Supabase Dashboard → Project Settings → API

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# Optional — must match PAIRING_CRON_SECRET on the Edge Function (for app/dev pairing invoke)
EXPO_PUBLIC_PAIRING_INVOKE_SECRET=

# LiveKit credentials are Supabase Edge Function secrets only (LIVEKIT_API_KEY, LIVEKIT_API_SECRET, LIVEKIT_URL).
# See docs/LIVEKIT_SETUP.md

# Contact verification (SMS / voice / email OTP) uses Supabase Edge Function secrets only:
# TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, TWILIO_VERIFY_SERVICE_SID, optional RESEND_API_KEY + RESEND_FROM_EMAIL
# See docs/CONTACT_VERIFICATION_SETUP.md

# For EAS cloud builds, also set these as EAS project secrets (see docs/EAS_BUILD_READINESS.md).
