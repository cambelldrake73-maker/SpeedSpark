{
  "expo": {
    "name": "Speed Spark",
    "slug": "speed-spark",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "speedspark",
    "userInterfaceStyle": "dark",
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "SpeedSpark needs photo access so you can upload profile pictures.",
          "cameraPermission": "SpeedSpark needs camera access so you can take profile photos."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "SpeedSpark uses your location to set your city for nearby matching — never your exact address."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "SpeedSpark needs camera access for live video dates.",
          "microphonePermission": "SpeedSpark needs microphone access so your date can hear you.",
          "recordAudioAndroid": true
        }
      ],
      [
        "@livekit/react-native-expo-plugin",
        {
          "android": {
            "audioType": "communication"
          }
        }
      ],
      "@config-plugins/react-native-webrtc",
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#FF6B35"
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.speedspark.app",
      "bitcode": false,
      "entitlements": {
        "aps-environment": "development"
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSUserNotificationsUsageDescription": "SpeedSpark sends notifications for new messages, matches, and when speed date windows go live."
      }
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "package": "com.speedspark.app",
      "adaptiveIcon": {
        "backgroundColor": "#0F0F0F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.INTERNET",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WAKE_LOCK",
        "android.permission.BLUETOOTH"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "backgroundColor": "#0F0F0F"
    },
    "extra": {
      "eas": {
        "projectId": "9b973426-224c-4392-a7ce-c46d2e016eba"
      }
    }
  }
}
